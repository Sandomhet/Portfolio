---
import {render} from "astro:content";
import "katex/dist/katex.min.css";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Toc from "../../components/Toc.astro";
import ProjectArt from "../../components/ProjectArt.astro";
import {categoryName, profile, sections} from "../../data/site";
import {formatDate, getItems, readingMinutes, SECTION_KEYS, type Item} from "../../lib/content";

export async function getStaticPaths() {
  const paths = [];
  for (const section of SECTION_KEYS) {
    const items = await getItems(section);
    for (const item of items) {
      // Prev/next stay inside the same category (or section when uncategorised).
      const peers = items.filter(i => i.category === item.category);
      const idx = peers.indexOf(item);
      paths.push({
        params: {section, slug: item.slug},
        props: {item, newer: peers[idx - 1], older: peers[idx + 1]},
      });
    }
  }
  return paths;
}

interface Props { item: Item; newer?: Item; older?: Item }
const {item, newer, older} = Astro.props;
const {entry, section, category} = item;
const data = entry.data as typeof entry.data & {summary?: string; tech?: string[]; repo?: string; demo?: string; cover?: string};
const {Content, headings} = await render(entry);

const isReading = section === "writing" || section === "blog";
const toc = isReading ? [] : headings.filter(h => h.depth >= 2 && h.depth <= 3);
const showToc = toc.length > 2;
const minutes = readingMinutes(entry.body);
const sectionInfo = sections[section];
---
<Base title={data.title} description={data.description || data.summary || sectionInfo.blurb} lang={data.lang === "zh" ? "zh-CN" : "en"} ogType="article">
  <div class:list={["container doc", {"has-toc": showToc, reading: isReading}]}>
    {showToc && (
      <aside class="toc-col">
        <div class="toc-sticky glass">
          <Toc headings={toc} />
        </div>
      </aside>
    )}

    <article class="main" data-pagefind-body>
      <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
        <a href={`/${section}`} class="crumb-back"><Icon name="arrow-left" size={15} /> {sectionInfo.label}</a>
        {category && <><span aria-hidden="true">/</span><a href={`/${section}${section === "code" ? `?c=${encodeURIComponent(category)}` : `#${category}`}`}>{categoryName(category)}</a></>}
      </nav>

      <header class="head">
        <h1 data-pagefind-meta="title">{data.title}</h1>
        {(data.description || data.summary) && <p class="desc">{data.description || data.summary}</p>}
        <div class="meta" data-pagefind-ignore>
          {isReading && <span class="by">{profile.name}</span>}
          <span><Icon name="calendar" size={14} /> <time datetime={data.time.toISOString()}>{formatDate(data.time)}</time></span>
          <span><Icon name="clock" size={14} /> {minutes} min read</span>
          <span><Icon name="globe" size={14} /> {data.lang === "zh" ? "中文" : "English"}</span>
        </div>
        {section === "projects" && (
          <div class="project-extra" data-pagefind-ignore>
            {data.tech && data.tech.length > 0 && <ul class="tech">{data.tech.map(t => <li class="chip">{t}</li>)}</ul>}
            <div class="plinks">
              {data.repo && <a class="btn" href={data.repo} target="_blank" rel="noopener noreferrer"><Icon name="github" size={16} /> Source</a>}
              {data.demo && <a class="btn btn-primary" href={data.demo} target="_blank" rel="noopener noreferrer">Live <Icon name="arrow-up-right" size={16} /></a>}
            </div>
          </div>
        )}
      </header>

      {section === "projects" && (
        <div class="pcover glass">
          {data.cover ? <img src={data.cover} alt="" /> : <ProjectArt seed={data.title} class="art" />}
        </div>
      )}

      {showToc && (
        <details class="toc-mobile glass" data-pagefind-ignore>
          <summary><Icon name="list" size={16} /> On this page</summary>
          <Toc headings={toc} />
        </details>
      )}

      <div class="prose" lang={data.lang === "zh" ? "zh" : "en"}>
        <Content />
      </div>

      {(newer || older) && (
        <nav class="pager" aria-label="More in this category" data-pagefind-ignore>
          {older ? (
            <a href={older.href} class="glass card-link">
              <span class="pl">Previous</span><span class="pt">{older.entry.data.title}</span>
            </a>
          ) : <span />}
          {newer ? (
            <a href={newer.href} class="glass card-link next">
              <span class="pl">Next</span><span class="pt">{newer.entry.data.title}</span>
            </a>
          ) : <span />}
        </nav>
      )}
    </article>
  </div>
</Base>

<style>
  .doc { display: grid; grid-template-columns: minmax(0, var(--read-w)); justify-content: center; gap: 48px; padding-top: 40px; }
  .doc.has-toc { grid-template-columns: 240px minmax(0, 820px); }
  .doc.reading { --read-w: 700px; }

  .toc-col { position: relative; }
  .toc-sticky { position: sticky; top: calc(var(--nav-h) + 24px); max-height: calc(100vh - var(--nav-h) - 48px); overflow-y: auto; padding: 18px 10px 18px 8px; }

  .crumbs { display: flex; align-items: center; gap: 10px; font-size: .85rem; color: var(--text-3); }
  .crumbs a { color: var(--text-2); font-weight: 550; }
  .crumbs a:hover { color: var(--accent); }
  .crumb-back { display: inline-flex; align-items: center; gap: 6px; }

  .head { margin: 22px 0 32px; padding-bottom: 28px; border-bottom: 1px solid var(--border); }
  .reading .head { text-align: center; }
  h1 { margin: 0; font-size: clamp(1.9rem, 4vw, 2.75rem); line-height: 1.15; letter-spacing: -.035em; font-weight: 780; }
  .desc { margin: 14px 0 0; font-size: 1.08rem; color: var(--text-2); }
  .reading .desc { font-style: italic; max-width: 560px; margin-left: auto; margin-right: auto; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 18px; font-size: .85rem; color: var(--text-3); }
  .reading .meta { justify-content: center; }
  .meta span { display: inline-flex; align-items: center; gap: 6px; }
  .by { font-weight: 650; color: var(--text-2); }

  .project-extra { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between; }
  .tech { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .plinks { display: flex; gap: 10px; }
  .pcover { overflow: hidden; border-radius: var(--radius-lg); aspect-ratio: 16 / 7; margin-bottom: 32px; }
  .pcover img, .pcover :global(.art) { width: 100%; height: 100%; object-fit: cover; display: block; }

  .toc-mobile { display: none; margin-bottom: 28px; padding: 12px 14px; }
  .toc-mobile summary { display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 600; font-size: .9rem; list-style: none; }
  .toc-mobile summary::-webkit-details-marker { display: none; }
  .toc-mobile[open] summary { margin-bottom: 12px; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 64px; }
  .pager a { padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; }
  .pager .next { text-align: right; }
  .pl { font-size: .75rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--text-3); }
  .pt { font-weight: 600; line-height: 1.4; }

  @media (max-width: 1100px) {
    .doc.has-toc { grid-template-columns: minmax(0, 820px); }
    .toc-col { display: none; }
    .toc-mobile { display: block; }
  }
  @media (max-width: 560px) {
    .doc { padding-top: 24px; }
    .pager { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Copy buttons and language labels for code blocks.
  document.querySelectorAll<HTMLPreElement>(".prose pre").forEach(pre => {
    const wrap = document.createElement("div");
    wrap.className = "code-wrap";
    pre.replaceWith(wrap);
    wrap.append(pre);
    const lang = pre.dataset.language;
    if (lang && lang !== "plaintext") {
      const tag = document.createElement("span");
      tag.className = "lang";
      tag.textContent = lang;
      wrap.append(tag);
    }
    const btn = document.createElement("button");
    btn.className = "copy";
    btn.type = "button";
    btn.setAttribute("aria-label", "Copy code");
    const copyIcon = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
    const doneIcon = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
    btn.innerHTML = copyIcon;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector("code")?.innerText ?? pre.innerText);
        btn.dataset.copied = "";
        btn.innerHTML = doneIcon;
        setTimeout(() => { delete btn.dataset.copied; btn.innerHTML = copyIcon; }, 1600);
      } catch {}
    });
    wrap.append(btn);
  });

  // Scroll spy for the table of contents.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")];
  if (links.length) {
    const targets = [...new Set(links.map(a => a.dataset.toc!))]
      .map(id => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);
    const setActive = (id: string) => {
      links.forEach(a => a.setAttribute("aria-current", String(a.dataset.toc === id)));
      const active = document.querySelector<HTMLElement>(".toc-sticky [aria-current='true']");
      const box = document.querySelector<HTMLElement>(".toc-sticky");
      if (active && box) {
        const top = active.offsetTop - box.clientHeight / 2;
        box.scrollTo({top, behavior: "smooth"});
      }
    };
    let ticking = false;
    const update = () => {
      ticking = false;
      let current = targets[0]?.id;
      for (const t of targets) { if (t.getBoundingClientRect().top <= 120) current = t.id; else break; }
      if (current) setActive(current);
    };
    addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, {passive: true});
    update();
    links.forEach(a => a.addEventListener("click", () => {
      const d = a.closest("details");
      if (d) d.open = false;
    }));
  }
</script>
