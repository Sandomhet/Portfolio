---
import {render} from "astro:content";
import "katex/dist/katex.min.css";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Toc from "../../components/Toc.astro";
import ProjectArt from "../../components/ProjectArt.astro";
import {categoryName, profile, sections} from "../../data/site";
import {formatDate, getItems, readingMinutes, SECTION_KEYS, type Item} from "../../lib/content";

export async function getStaticPaths() {
  const paths = [];
  for (const section of SECTION_KEYS) {
    const items = await getItems(section);
    for (const item of items) {
      // Prev/next stay inside the same category (or section when uncategorised).
      const peers = items.filter(i => i.category === item.category);
      const idx = peers.indexOf(item);
      paths.push({
        params: {section, slug: item.slug},
        props: {item, newer: peers[idx - 1], older: peers[idx + 1]},
      });
    }
  }
  return paths;
}

interface Props { item: Item; newer?: Item; older?: Item }
const {item, newer, older} = Astro.props;
const {entry, section, category} = item;
const data = entry.data as typeof entry.data & {summary?: string; tech?: string[]; repo?: string; demo?: string; cover?: string};
const {Content, headings} = await render(entry);

const isReading = section === "writing" || section === "blog";
const toc = section === "writing" ? [] : headings.filter(h => h.depth >= 2 && h.depth <= 3);
const hasToc = toc.length > (section === "blog" ? 2 : 1);
const langClass = data.lang === "en" ? "markdown-en" : "markdown-zh";
const backHref = category ? `/${section}?c=${encodeURIComponent(category)}` : `/${section}`;
---
<Base title={data.title} description={data.description || data.summary || sections[section].blurb} lang={data.lang === "zh" ? "zh-CN" : "en"} ogType="article" serif={isReading}>
  <div class="viewer">
    {hasToc && (
      <aside class="toc-col"><Toc headings={toc} /></aside>
    )}

    <div class="main-col">
      <div class="action-bar">
        {hasToc && (
          <button class="icon-btn toc-btn" type="button" data-toc-open aria-label="Table of contents" title="Table of contents"><Icon name="menu" size={16} /></button>
        )}
        <a class="icon-btn" href={backHref} aria-label={`Back to ${sections[section].label}`} title="Go back"><Icon name="arrow-left" size={16} /></a>
        <span class="crumb">
          <a href={`/${section}`}>{sections[section].label}</a>
          {category && <> · <a href={backHref}>{categoryName(category)}</a></>}
        </span>
      </div>

      <div class="body-wrap">
        <article class="body" data-pagefind-body>
          <header class:list={["head", {centered: isReading}]}>
            <h1 data-pagefind-meta="title">{data.title}</h1>
            {(data.description || data.summary) && <p class="desc">{data.description || data.summary}</p>}
            <div class="meta" data-pagefind-ignore>
              {isReading && <span class="by">{profile.name}</span>}
              <span><Icon name="calendar" size={13} /> {formatDate(data.time, "weekday")}</span>
              <span><Icon name="clock" size={13} /> {readingMinutes(entry.body)} min read</span>
            </div>
            {section === "projects" && (
              <div class="project-extra" data-pagefind-ignore>
                {data.tech && data.tech.length > 0 && <div class="tech">{data.tech.map(t => <span class="chip">{t}</span>)}</div>}
                <div class="plinks">
                  {data.repo && <a class="btn" href={data.repo} target="_blank" rel="noopener noreferrer"><Icon name="github" size={15} /> Source</a>}
                  {data.demo && <a class="btn btn-primary" href={data.demo} target="_blank" rel="noopener noreferrer">Live <Icon name="arrow-up-right" size={15} /></a>}
                </div>
              </div>
            )}
          </header>

          {section === "projects" && (
            <div class="pcover">{data.cover ? <img src={data.cover} alt="" /> : <ProjectArt seed={data.title} class="art" />}</div>
          )}

          <div class:list={[langClass, {"prose-serif": isReading}]} lang={data.lang === "zh" ? "zh" : "en"}>
            <Content />
          </div>

          {(newer || older) && (
            <nav class="pager" aria-label="More in this category" data-pagefind-ignore>
              {older ? (
                <a href={older.href} class="surface hover-lift"><span class="pl">← Previous</span><span class="pt">{older.entry.data.title}</span></a>
              ) : <span />}
              {newer ? (
                <a href={newer.href} class="surface hover-lift next"><span class="pl">Next →</span><span class="pt">{newer.entry.data.title}</span></a>
              ) : <span />}
            </nav>
          )}
        </article>
      </div>
    </div>
  </div>

  {hasToc && (
    <div class="toc-scrim" id="toc-drawer" hidden>
      <div class="toc-drawer"><Toc headings={toc} /></div>
    </div>
  )}
</Base>

<style>
  .viewer { display: flex; min-height: calc(100vh - 64px); }

  .toc-col {
    width: 240px;
    flex-shrink: 0;
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow-y: auto;
    border-right: 1px solid var(--sidebar-border);
    scrollbar-width: thin;
    scrollbar-color: var(--scrollbar-thumb) transparent;
  }

  .main-col { flex: 1; min-width: 0; display: flex; flex-direction: column; }

  .action-bar {
    position: sticky;
    top: 64px;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 40px;
    background: var(--nav-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--nav-border);
  }
  .action-bar .icon-btn { width: 30px; height: 30px; }
  .toc-btn { display: none; }
  .crumb { font-size: .75rem; color: var(--text-muted); }
  .crumb a:hover { color: var(--nav-active); }

  .body-wrap { flex: 1; display: flex; justify-content: center; }
  .body { width: 100%; max-width: 820px; min-width: 0; padding: 32px 40px 64px; }
  .body > * { max-width: 46rem; }
  .body:has(.prose-serif) > * { margin-left: auto; margin-right: auto; }

  .head { margin-bottom: 28px; padding-bottom: 20px; border-bottom: 1px solid var(--surface-border); }
  .head h1 {
    margin: .2em 0 .35em;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -.02em;
    background: var(--h1-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .head .desc { margin: 0; font-size: 1.02rem; line-height: 1.6; color: var(--text-secondary); }
  .head .meta { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 12px; font-size: .78rem; line-height: 1.4; color: var(--text-muted); }
  .head .meta span { display: inline-flex; align-items: center; gap: 5px; }
  .head .by { font-weight: 600; color: var(--text-secondary); }
  .centered { text-align: center; }
  .centered .meta { justify-content: center; }
  .centered .desc { font-family: var(--font-serif); font-size: 1.12rem; font-style: italic; max-width: 56ch; margin: 0 auto; }

  .project-extra { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; }
  .tech { display: flex; flex-wrap: wrap; gap: 6px; }
  .tech .chip { height: 22px; font-size: .7rem; padding: 0 8px; }
  .plinks { display: flex; gap: 8px; }
  .pcover { overflow: hidden; border-radius: 20px; aspect-ratio: 16 / 7; margin-bottom: 28px; border: 1px solid var(--surface-border); }
  .pcover img, .pcover :global(.art) { display: block; width: 100%; height: 100%; object-fit: cover; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 56px; }
  .pager a { display: flex; flex-direction: column; gap: 4px; padding: 14px 18px; border-radius: 20px; }
  .pager .next { text-align: right; }
  .pl { font-size: .72rem; color: var(--text-muted); }
  .pt { font-size: .9rem; font-weight: 600; color: var(--text-primary); line-height: 1.4; }

  .toc-scrim { position: fixed; inset: 0; z-index: 1200; background: rgba(15, 8, 40, .35); }
  .toc-drawer {
    --from: -100%;
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 260px;
    overflow-y: auto;
    padding-top: 8px;
    background: var(--drawer-bg);
    border-right: 1px solid var(--drawer-border);
    animation: sheetIn .22s ease;
  }

  @media (max-width: 1199px) {
    .toc-col { display: none; }
    .toc-btn { display: inline-grid; }
  }
  @media (max-width: 899px) {
    .action-bar { padding: 10px 24px; }
    .body { padding: 28px 24px 56px; }
  }
  @media (max-width: 599px) {
    .head h1 { font-size: 1.55rem; }
    .action-bar { padding: 10px 16px; }
    .body { padding: 24px 16px 48px; }
    .pager { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Header bar (language + copy button) on code blocks.
  const LANGS: Record<string, string> = {
    cpp: "C++", c: "C", py: "Python", python: "Python", js: "JavaScript", javascript: "JavaScript",
    ts: "TypeScript", typescript: "TypeScript", jsx: "JSX", tsx: "TSX", java: "Java", go: "Go",
    rust: "Rust", sh: "Shell", bash: "Shell", shell: "Shell", zsh: "Shell", json: "JSON", yaml: "YAML",
    yml: "YAML", html: "HTML", css: "CSS", sql: "SQL", md: "Markdown", markdown: "Markdown",
    tex: "LaTeX", latex: "LaTeX", txt: "Text", text: "Text", plaintext: "Text", asm: "Assembly",
    mips: "MIPS", armasm: "Assembly", verilog: "Verilog", matlab: "MATLAB", r: "R", kotlin: "Kotlin",
  };
  const copyIcon = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
  const doneIcon = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
  document.querySelectorAll<HTMLPreElement>(".markdown-zh pre, .markdown-en pre").forEach(pre => {
    const id = [...pre.classList].find(c => c.startsWith("language-"))?.slice(9) ?? "";
    const wrap = document.createElement("div");
    wrap.className = "code-wrap";
    const head = document.createElement("div");
    head.className = "code-head";
    const label = document.createElement("span");
    label.className = "code-lang";
    label.textContent = LANGS[id.toLowerCase()] ?? (id ? id.toUpperCase() : "Code");
    const btn = document.createElement("button");
    btn.className = "copy";
    btn.type = "button";
    btn.setAttribute("aria-label", "Copy code");
    const idle = `${copyIcon}<span>Copy</span>`;
    btn.innerHTML = idle;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector("code")?.textContent ?? pre.textContent ?? "");
        btn.dataset.copied = "";
        btn.innerHTML = `${doneIcon}<span>Copied</span>`;
        setTimeout(() => { delete btn.dataset.copied; btn.innerHTML = idle; }, 2000);
      } catch {}
    });
    head.append(label, btn);
    pre.replaceWith(wrap);
    wrap.append(head, pre);
  });

  // Mobile TOC drawer.
  const scrim = document.getElementById("toc-drawer");
  const closeToc = () => { if (scrim) scrim.hidden = true; };
  document.querySelector("[data-toc-open]")?.addEventListener("click", () => { if (scrim) scrim.hidden = false; });
  scrim?.addEventListener("click", e => { if (e.target === scrim) closeToc(); });
  document.addEventListener("keydown", e => { if (e.key === "Escape") closeToc(); });

  // Scroll spy.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")];
  if (links.length) {
    const targets = [...new Set(links.map(a => a.dataset.toc!))]
      .map(id => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);
    const sidebar = document.querySelector<HTMLElement>(".toc-col");
    let current = "";
    const update = () => {
      let id = targets[0]?.id ?? "";
      for (const t of targets) { if (t.getBoundingClientRect().top <= 140) id = t.id; else break; }
      if (id === current) return;
      current = id;
      links.forEach(a => a.classList.toggle("active", a.dataset.toc === id));
      const active = sidebar?.querySelector<HTMLElement>(".toc-link.active");
      if (sidebar && active) sidebar.scrollTo({top: active.offsetTop - sidebar.clientHeight / 2, behavior: "smooth"});
    };
    let ticking = false;
    addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; update(); }); } }, {passive: true});
    update();
    links.forEach(a => a.addEventListener("click", closeToc));
  }
</script>
