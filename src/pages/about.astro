---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Quote from "../components/Quote.astro";
import Avatar from "../components/Avatar.astro";
import {categoryName, profile, socials} from "../data/site";
import {getItems, groupBy} from "../lib/content";

const notes = await getItems("notes");
const code = await getItems("code");
const writing = await getItems("writing");
const DEPTS = ["CMPSC", "EECS", "MATH", "PHYS+CHEM"];
const byCode = [...notes].sort((a, b) => a.entry.data.title.localeCompare(b.entry.data.title, "en", {numeric: true}));
const coursework = groupBy(byCode, n => n.category).sort(([a], [b]) => DEPTS.indexOf(a) - DEPTS.indexOf(b));

const focus = [
  {icon: "code", title: "Algorithms & data structures", text: `${code.length} write ups and templates, from segment trees to network flow.`},
  {icon: "spark", title: "Competitive programming", text: "Training for ICPC style contests and keeping a printable C++ notebook."},
  {icon: "notebook", title: "Coursework", text: `Notes for ${notes.length} courses across computer science, math and physics.`},
  {icon: "feather", title: "Writing", text: `${writing.length} essays in English on books, identity and media.`},
];
---
<Base title="About" description={profile.intro}>
  <div class="container">
    <section class="intro">
      <div class="portrait glass">
        <Avatar size={180} />
        <div class="who">
          <div class="name">{profile.name}</div>
          <div class="tag">{profile.handle} · {profile.tagline}</div>
        </div>
        <div class="links">
          {socials.map(s => (
            <a href={s.href} class="link" target={s.icon === "mail" ? undefined : "_blank"} rel="noopener noreferrer">
              <Icon name={s.icon} size={16} /> {s.label}
            </a>
          ))}
        </div>
      </div>

      <div class="text">
        <span class="eyebrow"><Icon name="user" size={14} /> About me</span>
        <h1>Hi, I'm <span class="grad-text">{profile.name.split(" ")[0]}</span>.</h1>
        <p class="lead">{profile.intro}</p>
        {profile.about.map(p => <p>{p}</p>)}
        <div class="cta">
          <a href={`mailto:${profile.email}`} class="btn btn-primary"><Icon name="mail" size={16} /> Get in touch</a>
          <a href="/code" class="btn">Browse my notes <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </section>

    <section class="block">
      <h2>What I spend time on</h2>
      <div class="focus">
        {focus.map(f => (
          <div class="f glass">
            <span class="ficon"><Icon name={f.icon} size={20} /></span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="block two">
      <div>
        <h2>Coursework</h2>
        <div class="courses glass">
          {coursework.map(([dept, list]) => (
            <div class="dept">
              <div class="dname">{categoryName(dept)}</div>
              <ul>{list.map(n => <li><a href={n.href}>{n.entry.data.title}</a></li>)}</ul>
            </div>
          ))}
        </div>
      </div>
      <div>
        <h2>A line I like</h2>
        <Quote />
      </div>
    </section>
  </div>
</Base>

<style>
  .intro { display: grid; grid-template-columns: 320px 1fr; gap: 48px; align-items: start; padding-top: 56px; }
  .portrait { padding: 28px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; border-radius: var(--radius-lg); position: sticky; top: calc(var(--nav-h) + 24px); }
  .name { font-size: 1.35rem; font-weight: 750; letter-spacing: -.02em; }
  .tag { font-size: .88rem; color: var(--text-3); }
  .links { width: 100%; display: flex; flex-direction: column; gap: 6px; }
  .link { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 10px; font-size: .9rem; font-weight: 550; color: var(--text-2); border: 1px solid var(--border); transition: all .2s var(--ease); }
  .link:hover { color: var(--accent); border-color: var(--border-strong); background: var(--accent-soft); }

  h1 { margin: 14px 0 18px; font-size: clamp(2.3rem, 5vw, 3.4rem); line-height: 1.05; letter-spacing: -.04em; font-weight: 780; }
  .text p { margin: 0 0 16px; font-size: 1.05rem; line-height: 1.8; color: var(--text-2); max-width: 680px; }
  .text .lead { font-size: 1.2rem; color: var(--text); }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  .block { margin-top: 72px; }
  .block h2 { margin: 0 0 18px; font-size: 1.4rem; letter-spacing: -.025em; }
  .focus { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .f { padding: 22px; border-radius: var(--radius-lg); }
  .ficon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; color: var(--accent); background: var(--accent-soft); }
  .f h3 { margin: 16px 0 6px; font-size: 1rem; font-weight: 680; }
  .f p { margin: 0; font-size: .9rem; color: var(--text-2); }

  .two { display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: start; }
  .courses { padding: 8px 22px; }
  .dept { padding: 16px 0; border-bottom: 1px solid var(--border); }
  .dept:last-child { border-bottom: 0; }
  .dname { font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; }
  .dept ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }
  .dept a { font-size: .93rem; color: var(--text-2); }
  .dept a:hover { color: var(--accent); }

  @media (max-width: 960px) {
    .intro { grid-template-columns: 1fr; gap: 32px; }
    .portrait { position: static; }
    .focus { grid-template-columns: 1fr 1fr; }
    .two { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) { .focus { grid-template-columns: 1fr; } }
</style>
