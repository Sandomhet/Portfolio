---
import SectionPage from "../../components/SectionPage.astro";
import FilterList from "../../components/FilterList.astro";
import Icon from "../../components/Icon.astro";
import {getItems} from "../../lib/content";
const items = await getItems("blog");
---
<SectionPage section="blog" lead="Shorter, more personal posts: what I am up to, what I am thinking about, and things worth remembering.">
  {items.length > 0 ? <FilterList items={items} /> : (
    <div class="empty surface">
      <Icon name="coffee" size={26} />
      <h2>First post is brewing</h2>
      <p>Nothing here yet. New posts will show up here as soon as they are written.</p>
    </div>
  )}
</SectionPage>
