---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import StoryList from "../../components/StoryList.astro";
import {sections} from "../../data/site";
import {getItems} from "../../lib/content";

const items = await getItems("writing");
const info = sections.writing;
---
<Base title={info.title} description={info.blurb}>
  <div class="container narrow">
    <header class="page-head">
      <span class="eyebrow"><Icon name="feather" size={14} /> {info.label}</span>
      <h1>{info.title}</h1>
      <p>Longer pieces in English: reflections on reading, identity and the media we spend our days inside.</p>
      <div class="meta">{items.length} essays</div>
    </header>
    <StoryList items={items} />
  </div>
</Base>

<style>.narrow { max-width: 900px; }</style>
