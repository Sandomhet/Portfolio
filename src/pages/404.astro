---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base title="Not found">
  <div class="container wrap">
    <div class="box glass">
      <span class="big grad-text">404</span>
      <h1>This page wandered off.</h1>
      <p>The link may be old: this site was reorganised, so try searching or start from one of the sections.</p>
      <div class="cta">
        <button class="btn btn-primary" type="button" data-search-open><Icon name="search" size={16} /> Search</button>
        <a href="/" class="btn">Go home</a>
      </div>
    </div>
  </div>
</Base>

<style>
  .wrap { display: grid; place-items: center; min-height: 60vh; padding-top: 48px; }
  .box { max-width: 520px; padding: 40px; text-align: center; border-radius: var(--radius-lg); }
  .big { font-size: 5rem; font-weight: 800; letter-spacing: -.06em; line-height: 1; }
  h1 { margin: 12px 0 8px; font-size: 1.5rem; letter-spacing: -.02em; }
  p { margin: 0; color: var(--text-2); }
  .cta { display: flex; gap: 12px; justify-content: center; margin-top: 24px; }
</style>
