---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base title="Not found">
  <div class="wrap">
    <div class="box surface">
      <div class="big title-text">404</div>
      <h1>This page wandered off.</h1>
      <p>The link may be old: this site was reorganised, so try searching or start from the home page.</p>
      <div class="cta">
        <button class="btn btn-primary" type="button" data-search-open><Icon name="search" size={15} /> Search</button>
        <a href="/" class="btn">Go home</a>
      </div>
    </div>
  </div>
</Base>

<style>
  .wrap { display: grid; place-items: center; min-height: calc(100vh - 64px); padding: 24px 16px; }
  .box { max-width: 480px; padding: 36px; text-align: center; border-radius: 24px; animation: fadeIn .35s ease; }
  .big { font-size: 4.5rem; font-weight: 800; letter-spacing: -.05em; line-height: 1; }
  h1 { margin: 12px 0 6px; font-size: 1.3rem; color: var(--text-primary); }
  p { margin: 0; font-size: .9rem; color: var(--text-secondary); }
  .cta { display: flex; gap: 10px; justify-content: center; margin-top: 22px; }
</style>
