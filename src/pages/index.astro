---
import Sidebar from "../layouts/Sidebar.astro";
import Icon from "../components/Icon.astro";
import PreviewCard from "../components/PreviewCard.astro";
import {categoryName, profile, sections, type SectionKey} from "../data/site";
import {getAllItems, getItems, groupBy, SECTION_KEYS} from "../lib/content";

const all = await getAllItems();
const latest = all.filter(i => i.section !== "projects").slice(0, 6);
const counts = Object.fromEntries(
  await Promise.all(SECTION_KEYS.map(async k => [k, (await getItems(k)).length])),
) as Record<SectionKey, number>;

const notes = await getItems("notes");
const DEPTS = ["CMPSC", "EECS", "MATH", "PHYS+CHEM"];
const coursework = groupBy(
  [...notes].sort((a, b) => a.entry.data.title.localeCompare(b.entry.data.title, "en", {numeric: true})),
  n => n.category,
).sort(([a], [b]) => DEPTS.indexOf(a) - DEPTS.indexOf(b));
const courseCode = (t: string) => t.match(/^([A-Za-z]+\s+[\w+]+)/)?.[1] ?? t;

const countLabel: Record<SectionKey, string> = {
  code: `${counts.code} topics`,
  notes: `${counts.notes} courses`,
  writing: `${counts.writing} essays`,
  blog: counts.blog ? `${counts.blog} posts` : "Coming soon",
  projects: `${counts.projects} projects`,
};
const order: SectionKey[] = ["code", "notes", "writing", "blog", "projects"];
---
<Sidebar>
  <section id="about" class="about">
    <div class="section-head">
      <h1 class="title-text">About me</h1>
      <p>{profile.name} · {profile.tagline}</p>
    </div>

    <div class="intro surface">
      <p class="lead">{profile.intro}</p>
      {profile.about.map(p => <p>{p}</p>)}
      <div class="cta">
        <a class="btn btn-primary" href={`mailto:${profile.email}`}><Icon name="mail" size={16} /> Get in touch</a>
        <a class="btn" href="https://github.com/Sandomhet" target="_blank" rel="noopener noreferrer"><Icon name="github" size={16} /> GitHub</a>
      </div>
    </div>

    <div class="subhead"><h2>Coursework</h2><a href="/notes">All notes →</a></div>
    <div class="courses surface">
      {coursework.map(([dept, list]) => (
        <div class="dept">
          <span class="dname">{categoryName(dept)}</span>
          <div class="codes">
            {list.map(n => <a class="chip course" href={n.href} title={n.entry.data.title}>{courseCode(n.entry.data.title)}</a>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <div class="subhead"><h2>Explore</h2></div>
  <div class="tiles">
    {order.map(key => (
      <a href={`/${key}`} class="tile surface hover-lift">
        <span class="ticon"><Icon name={sections[key].icon} size={18} /></span>
        <span class="tname">{sections[key].title}</span>
        <span class="tcount">{countLabel[key]}</span>
      </a>
    ))}
  </div>

  <div class="subhead"><h2>Recently updated</h2></div>
  <div class="stack">
    {latest.map(item => <PreviewCard item={item} label="section" />)}
  </div>
</Sidebar>

<style>
  .intro { padding: 22px 24px; border-radius: 24px; }
  .intro p { margin: 0 0 12px; font-size: .95rem; line-height: 1.75; color: var(--text-secondary); }
  .intro .lead { font-size: 1.05rem; color: var(--text-primary); }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }

  .courses { padding: 6px 20px; border-radius: 20px; }
  .dept { display: flex; gap: 16px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--surface-border); }
  .dept:last-child { border-bottom: 0; }
  .dname { width: 150px; flex-shrink: 0; font-size: .8rem; font-weight: 600; color: var(--text-secondary); }
  .codes { display: flex; flex-wrap: wrap; gap: 6px; }
  .course { height: 24px; padding: 0 9px; font-size: .74rem; font-weight: 500; transition: all .18s ease; }
  .course:hover { border-color: var(--chip-inactive-hover-border); background: var(--chip-inactive-hover-bg); }

  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .tile { display: flex; flex-direction: column; gap: 4px; padding: 16px; border-radius: 20px; }
  .ticon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-bottom: 8px;
    border-radius: 10px;
    color: #fff;
    background: linear-gradient(135deg, #8B5CF6, #6D3FC8);
  }
  .tname { font-size: .9rem; font-weight: 600; line-height: 1.3; color: var(--text-primary); }
  .tcount { font-size: .73rem; color: var(--text-muted); }

  @media (max-width: 599px) {
    .dept { flex-direction: column; gap: 6px; }
    .dname { width: auto; }
  }
</style>
