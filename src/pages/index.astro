---
import Sidebar from "../layouts/Sidebar.astro";
import {profile} from "../data/site";
---
<Sidebar>
  <section id="about" class="about">
    <div class="section-head">
      <h1 class="title-text">About me</h1>
    </div>
    {profile.about.map(p => <p>{p}</p>)}
  </section>
</Sidebar>

<style>
  .about { max-width: 44rem; }
  p { margin: 0 0 1.1em; font-size: 1.05rem; line-height: 1.8; color: var(--text-primary); }
</style>
