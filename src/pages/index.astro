---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import EntryRow from "../components/EntryRow.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Quote from "../components/Quote.astro";
import Avatar from "../components/Avatar.astro";
import {profile, sections, socials, type SectionKey} from "../data/site";
import {getAllItems, getItems, SECTION_KEYS} from "../lib/content";

const all = await getAllItems();
const latest = all.filter(i => i.section !== "projects").slice(0, 6);
const counts = Object.fromEntries(
  await Promise.all(SECTION_KEYS.map(async k => [k, (await getItems(k)).length])),
) as Record<SectionKey, number>;
const projects = await getItems("projects");
const featured = [...projects.filter(p => (p.entry.data as any).featured), ...projects.filter(p => !(p.entry.data as any).featured)].slice(0, 3);

const countLabel: Record<SectionKey, string> = {
  code: `${counts.code} topics`,
  notes: `${counts.notes} courses`,
  writing: `${counts.writing} essays`,
  blog: counts.blog ? `${counts.blog} posts` : "Coming soon",
  projects: `${counts.projects} projects`,
};
const order: SectionKey[] = ["code", "notes", "writing", "projects", "blog"];
---
<Base>
  <section class="container hero">
    <div class="hero-text">
      <span class="eyebrow rise">Hi, I'm {profile.name.split(" ")[0]}</span>
      <h1 class="rise rise-2">
        Notes on <span class="grad-text">algorithms</span>, <br class="br" />
        coursework &amp; words.
      </h1>
      <p class="lead rise rise-3">{profile.intro}</p>
      <div class="cta rise rise-4">
        <a href="/code" class="btn btn-primary">Explore the code <Icon name="arrow" size={16} /></a>
        <a href="/about" class="btn">About me</a>
      </div>
    </div>

    <aside class="hero-side rise rise-3">
      <div class="profile glass">
        <Avatar size={88} />
        <div>
          <div class="pname">{profile.short}</div>
          <div class="ptag">{profile.tagline}</div>
          <div class="psocials">
            {socials.map(s => (
              <a href={s.href} class="icon-btn" target={s.icon === "mail" ? undefined : "_blank"} rel="noopener noreferrer" aria-label={s.label} title={s.label}>
                <Icon name={s.icon} size={16} />
              </a>
            ))}
          </div>
        </div>
      </div>
      <Quote />
    </aside>
  </section>

  <section class="container block">
    <div class="block-head">
      <h2>Explore</h2>
    </div>
    <div class="sections">
      {order.map(key => (
        <a href={`/${key}`} class:list={["section glass card-link", `s-${key}`]}>
          <span class="s-icon"><Icon name={sections[key].icon} size={22} /></span>
          <span class="s-count">{countLabel[key]}</span>
          <h3>{sections[key].title}</h3>
          <p>{sections[key].blurb}</p>
          <span class="s-go"><Icon name="arrow" size={18} /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="container block">
    <div class="block-head">
      <h2>Recently updated</h2>
    </div>
    <div class="list">
      {latest.map(item => <EntryRow item={item} showSection />)}
    </div>
  </section>

  {featured.length > 0 && (
    <section class="container block">
      <div class="block-head">
        <h2>Projects</h2>
        <a href="/projects" class="more">All projects <Icon name="arrow" size={15} /></a>
      </div>
      <div class="projects">
        {featured.map(item => <ProjectCard item={item} />)}
      </div>
    </section>
  )}
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, .9fr);
    gap: 48px;
    align-items: center;
    padding-top: 72px;
    padding-bottom: 32px;
  }
  h1 {
    margin: 16px 0 18px;
    font-size: clamp(2.5rem, 5.6vw, 4.2rem);
    line-height: 1.04;
    letter-spacing: -.045em;
    font-weight: 780;
  }
  .lead { margin: 0; max-width: 560px; font-size: 1.12rem; color: var(--text-2); }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }

  .hero-side { display: flex; flex-direction: column; gap: 16px; }
  .profile { display: flex; align-items: center; gap: 18px; padding: 20px 22px; }
  .pname { font-size: 1.25rem; font-weight: 750; letter-spacing: -.02em; }
  .ptag { font-size: .88rem; color: var(--text-3); }
  .psocials { display: flex; gap: 6px; margin-top: 10px; }
  .psocials .icon-btn { width: 34px; height: 34px; }

  .block { margin-top: 72px; }
  .block-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px; }
  .block-head h2 { margin: 0; font-size: 1.45rem; letter-spacing: -.025em; font-weight: 720; }
  .more { display: inline-flex; align-items: center; gap: 6px; font-size: .9rem; font-weight: 600; color: var(--accent); }

  .sections { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
  .section { position: relative; grid-column: span 2; padding: 24px; border-radius: var(--radius-lg); min-height: 190px; overflow: hidden; }
  .s-code, .s-notes { grid-column: span 3; }
  .section::before {
    content: "";
    position: absolute;
    right: -60px;
    top: -60px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: var(--grad);
    opacity: .12;
    filter: blur(10px);
    transition: opacity .3s var(--ease), transform .4s var(--ease);
  }
  .section:hover::before { opacity: .22; transform: scale(1.15); }
  .s-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 13px;
    color: #fff;
    background: var(--grad);
    box-shadow: 0 6px 18px rgba(124, 58, 237, .3), inset 0 1px 0 rgba(255, 255, 255, .3);
  }
  .s-count { position: absolute; top: 26px; right: 24px; font-size: .78rem; font-weight: 600; color: var(--text-3); }
  .section h3 { margin: 18px 0 6px; font-size: 1.15rem; font-weight: 700; letter-spacing: -.015em; }
  .section p { margin: 0; font-size: .92rem; color: var(--text-2); max-width: 360px; }
  .s-go { position: absolute; right: 22px; bottom: 20px; color: var(--accent); opacity: 0; transform: translateX(-6px); transition: all .25s var(--ease); }
  .section:hover .s-go { opacity: 1; transform: none; }

  .list { display: flex; flex-direction: column; gap: 10px; }
  .projects { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; padding-top: 48px; gap: 32px; }
    .sections { grid-template-columns: 1fr 1fr; }
    .section, .s-code, .s-notes { grid-column: span 1; }
  }
  @media (max-width: 560px) {
    .br { display: none; }
    .sections { grid-template-columns: 1fr; }
    .block { margin-top: 56px; }
  }
</style>
