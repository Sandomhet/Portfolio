---
import SectionPage from "../../components/SectionPage.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import {getItems} from "../../lib/content";
const items = await getItems("projects");
const sorted = [...items.filter(p => (p.entry.data as any).featured), ...items.filter(p => !(p.entry.data as any).featured)];
---
<SectionPage section="projects" lead="Things I have built, with the story behind them.">
  <div class="grid">
    {sorted.map(item => <ProjectCard item={item} />)}
  </div>
</SectionPage>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
</style>
