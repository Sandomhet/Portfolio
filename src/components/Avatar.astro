---
import {profile} from "../data/site";
interface Props { size: number }
const {size} = Astro.props;
---
<span class="ring" style={`--size:${size}px`}>
  <span class="clip"><img src={profile.avatar} alt={profile.name} width={size} height={size} /></span>
</span>

<style>
  .ring { display: inline-block; flex-shrink: 0; padding: 3px; border-radius: 50%; background: var(--grad); box-shadow: 0 8px 28px rgba(124, 58, 237, .35); }
  .clip { display: block; width: var(--size); height: var(--size); border-radius: 50%; overflow: hidden; border: 3px solid var(--bg); }
  /* The source image has a thin dark frame; crop it out. */
  img { display: block; width: 100%; height: 100%; object-fit: cover; transform: scale(1.08); }
</style>
