---
// The old PreviewWidget card.
import Icon from "./Icon.astro";
import {categoryName, sections} from "../data/site";
import {formatDate, type Item} from "../lib/content";

interface Props { item: Item; label?: "section" | "category" | "none" }
const {item, label = "category"} = Astro.props;
const {title, description, time} = item.entry.data;
const chip = label === "section" ? sections[item.section].label : label === "category" && item.category ? categoryName(item.category) : "";
---
<a href={item.href} class="card surface hover-lift" data-category={item.category} data-title={title.toLowerCase()} data-desc={description.toLowerCase()}>
  <div class="text">
    <div class="meta">
      <time datetime={time.toISOString()}>{formatDate(time, "weekday")}</time>
      {chip && <span class="chip">{chip}</span>}
    </div>
    <h3>{title}</h3>
    {description && <p>{description}</p>}
  </div>
  <span class="arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
</a>

<style>
  .card { display: flex; align-items: flex-start; justify-content: space-between; padding: 20px; border-radius: 24px; }
  .text { flex: 1; min-width: 0; }
  .meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; font-size: .73rem; color: var(--text-muted); }
  h3 { margin: 0; font-size: 1rem; font-weight: 600; line-height: 1.35; letter-spacing: -.01em; color: var(--text-primary); }
  p { margin: 4px 0 0; font-size: .85rem; line-height: 1.55; color: var(--text-secondary); }
  .arrow { margin: 4px 0 0 16px; flex-shrink: 0; color: var(--nav-active); opacity: 0; transform: translateX(-6px); transition: all .2s ease; }
  .card:hover .arrow { opacity: 1; transform: none; }
</style>
