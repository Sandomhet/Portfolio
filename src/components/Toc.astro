---
import type {MarkdownHeading} from "astro";
interface Props { headings: MarkdownHeading[] }
const {headings} = Astro.props;
---
<nav class="toc" aria-label="On this page">
  <div class="toc-title">On this page</div>
  <ol>
    {headings.map(h => (
      <li class={`d${h.depth}`}><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
    ))}
  </ol>
</nav>

<style>
  .toc-title { font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); margin: 0 0 10px 12px; }
  ol { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--border); }
  a {
    display: block;
    margin-left: -1px;
    padding: 5px 12px;
    border-left: 2px solid transparent;
    font-size: .84rem;
    line-height: 1.45;
    color: var(--text-3);
    transition: color .15s, border-color .15s, background .15s;
  }
  .d3 a { padding-left: 24px; font-size: .8rem; }
  a:hover { color: var(--text); }
  a[aria-current="true"] { color: var(--accent); border-left-color: var(--accent-2); background: var(--accent-soft); font-weight: 550; }
</style>
