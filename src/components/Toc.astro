---
import type {MarkdownHeading} from "astro";
interface Props { headings: MarkdownHeading[] }
const {headings} = Astro.props;
---
<div class="toc">
  <div class="toc-title">On This Page</div>
  <nav class="toc-sidebar" aria-label="On this page">
    {headings.map(h => (
      <a href={`#${h.slug}`} class={`toc-link level-${h.depth}`} data-toc={h.slug} title={h.text}>{h.text}</a>
    ))}
  </nav>
</div>

<style>
  .toc { padding: 20px 16px 16px; }
  .toc-title {
    padding: 0 8px;
    margin-bottom: 12px;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
