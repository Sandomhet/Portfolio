---
import Icon from "./Icon.astro";
import {categoryName, sections} from "../data/site";
import {formatDate, type Item} from "../lib/content";

interface Props { item: Item; showSection?: boolean; showCategory?: boolean }
const {item, showSection = false, showCategory = true} = Astro.props;
const {title, description, time, lang} = item.entry.data;
const label = showSection ? sections[item.section].label : showCategory && item.category ? categoryName(item.category) : "";
---
<a href={item.href} class="row glass card-link" data-category={item.category} data-title={title.toLowerCase()} data-desc={description.toLowerCase()}>
  <div class="meta">
    <time datetime={time.toISOString()}>{formatDate(time)}</time>
    {label && <span class="chip">{label}</span>}
    {lang === "zh" && <span class="lang" title="Written in Chinese">中文</span>}
  </div>
  <h3>{title}</h3>
  {description && <p>{description}</p>}
  <span class="go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
</a>

<style>
  .row { position: relative; padding: 18px 56px 18px 22px; }
  .meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; font-size: .78rem; color: var(--text-3); }
  .lang { font-size: .72rem; padding: 1px 6px; border-radius: 6px; border: 1px solid var(--border); }
  h3 { margin: 0; font-size: 1.05rem; font-weight: 650; letter-spacing: -.01em; line-height: 1.4; }
  p {
    margin: 4px 0 0;
    font-size: .9rem;
    color: var(--text-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .go {
    position: absolute;
    right: 20px;
    top: 50%;
    color: var(--accent);
    opacity: 0;
    transform: translate(-6px, -50%);
    transition: all .25s var(--ease);
  }
  .row:hover .go { opacity: 1; transform: translate(0, -50%); }
</style>
