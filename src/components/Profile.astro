---
import Avatar from "./Avatar.astro";
import ExternalLinks from "./ExternalLinks.astro";
import Quote from "./Quote.astro";
import Icon from "./Icon.astro";
import {profile, socials} from "../data/site";
interface Props { compact?: boolean }
const {compact = false} = Astro.props;
---
{compact ? (
  <div class="compact">
    <Avatar size={72} />
    <div>
      <div class="name brand-text">{profile.name}</div>
      <div class="sub">{profile.short}</div>
      <ExternalLinks inline />
    </div>
  </div>
) : (
  <div class="full">
    <div class="card surface">
      <div class="av"><Avatar size={100} /></div>
      <div class="name brand-text">{profile.name}</div>
      <div class="sub">{profile.short}</div>
      <p class="focus">{profile.focus.map(line => <span>{line}</span>)}</p>
      <ul class="links">
        {socials.map(s => (
          <li>
            <a
              href={s.href}
              target={s.icon === "mail" ? undefined : "_blank"}
              rel="noopener noreferrer"
            >
              <Icon name={s.icon} size={16} />
              <span class="label">{s.label}</span>
              <span class="handle">{s.handle}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <Quote />
  </div>
)}

<style>
  .full { display: flex; flex-direction: column; text-align: center; }
  .card { padding: 26px 22px 18px; border-radius: 20px; }
  .av { display: flex; justify-content: center; margin: 2px 0 18px; }
  .compact { display: flex; align-items: center; gap: 24px; }
  .name { font-size: 1.15rem; font-weight: 700; letter-spacing: -.02em; line-height: 1.3; margin-bottom: 2px; text-wrap: balance; }
  .sub { font-size: .85rem; font-weight: 500; color: var(--text-muted); }
  .focus { margin: 12px 0 0; display: flex; flex-direction: column; font-size: .8rem; line-height: 1.55; color: var(--text-secondary); }
  .links { list-style: none; margin: 18px 0 0; padding: 14px 0 0; border-top: 1px solid var(--surface-border); text-align: left; display: flex; flex-direction: column; gap: 2px; }
  .links a { display: flex; align-items: center; gap: 11px; padding: 8px 10px; border-radius: 10px; font-size: .85rem; color: var(--text-secondary); transition: background .18s ease, color .18s ease; }
  .links a :global(svg) { flex-shrink: 0; color: var(--text-muted); transition: color .18s ease; }
  .links a:hover { background: var(--chip-bg); color: var(--text-primary); }
  .links a:hover :global(svg) { color: var(--nav-active); }
  .handle { margin-left: auto; font-size: .75rem; color: var(--text-muted); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
