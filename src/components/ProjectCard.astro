---
import Icon from "./Icon.astro";
import ProjectArt from "./ProjectArt.astro";
import type {Item} from "../lib/content";

interface Props { item: Item }
const {item} = Astro.props;
const {title, summary, tech, cover} = item.entry.data as any;
---
<a href={item.href} class="card glass card-link">
  <div class="cover">
    {cover ? <img src={cover} alt="" loading="lazy" /> : <ProjectArt seed={title} class="art" />}
  </div>
  <div class="body">
    <h3>{title} <Icon name="arrow-up-right" size={16} class="arrow" /></h3>
    <p>{summary}</p>
    {tech.length > 0 && (
      <ul class="tech">{tech.map((t: string) => <li class="chip">{t}</li>)}</ul>
    )}
  </div>
</a>

<style>
  .card { overflow: hidden; display: flex; flex-direction: column; border-radius: var(--radius-lg); }
  .cover { aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--border); }
  .cover img, .cover :global(.art) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s var(--ease); }
  .card:hover .cover img, .card:hover .cover :global(.art) { transform: scale(1.04); }
  .body { padding: 18px 20px 20px; }
  h3 { margin: 0 0 6px; font-size: 1.1rem; font-weight: 700; letter-spacing: -.01em; display: flex; align-items: center; gap: 6px; }
  h3 :global(.arrow) { color: var(--accent); opacity: .6; transition: transform .25s var(--ease); }
  .card:hover h3 :global(.arrow) { transform: translate(2px, -2px); opacity: 1; }
  p { margin: 0; font-size: .92rem; color: var(--text-2); }
  .tech { list-style: none; padding: 0; margin: 14px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
</style>
