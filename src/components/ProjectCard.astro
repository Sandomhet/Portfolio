---
import Icon from "./Icon.astro";
import ProjectArt from "./ProjectArt.astro";
import type {Item} from "../lib/content";

interface Props { item: Item }
const {item} = Astro.props;
const {title, summary, tech, cover} = item.entry.data as any;
---
<a href={item.href} class="card surface hover-lift">
  <div class="cover">
    {cover ? <img src={cover} alt="" loading="lazy" /> : <ProjectArt seed={title} class="art" />}
  </div>
  <div class="body">
    <h3>{title} <span class="arrow"><Icon name="arrow" size={16} /></span></h3>
    <p>{summary}</p>
    {tech.length > 0 && <div class="tech">{tech.map((t: string) => <span class="chip">{t}</span>)}</div>}
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; overflow: hidden; border-radius: 24px; }
  .cover { aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--surface-border); }
  .cover img, .cover :global(.art) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .card:hover .cover img, .card:hover .cover :global(.art) { transform: scale(1.04); }
  .body { padding: 16px 20px 20px; }
  h3 { display: flex; align-items: center; justify-content: space-between; margin: 0 0 6px; font-size: 1rem; font-weight: 600; color: var(--text-primary); }
  .arrow { color: var(--nav-active); opacity: 0; transform: translateX(-6px); transition: all .2s ease; }
  .card:hover .arrow { opacity: 1; transform: none; }
  p { margin: 0; font-size: .85rem; line-height: 1.55; color: var(--text-secondary); }
  .tech { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .tech .chip { height: 22px; font-size: .7rem; padding: 0 8px; }
</style>
