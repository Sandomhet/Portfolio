---
import Icon from "./Icon.astro";
import quotes from "../data/quotes.json";
const first = quotes[0];
---
<figure class="quote surface" data-quotes={JSON.stringify(quotes)}>
  <div class="head">
    <Icon name="book" size={16} class="book" />
    <span class="label">QUOTE OF THE DAY</span>
    <button type="button" aria-label="Another quote" title="Another quote"><Icon name="refresh" size={15} /></button>
  </div>
  <div class="body">
    <blockquote data-q>"{first.quote}"</blockquote>
    <figcaption data-c>{first.writer && `— ${first.writer}`}{first.source && ` · ${first.source}`}</figcaption>
  </div>
</figure>

<style>
  .quote { width: 100%; margin: 8px 0 0; text-align: left; border-radius: 20px; overflow: hidden; transition: border-color .2s ease; }
  .quote:hover { border-color: var(--surface-border-hover); }
  .head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 6px 12px;
    background: var(--chip-bg);
    border-bottom: 1px solid var(--surface-border);
  }
  .head :global(.book) { color: var(--nav-active); justify-self: start; }
  .label { font-size: .8rem; font-weight: 600; letter-spacing: .06em; color: var(--nav-active); }
  button {
    justify-self: end;
    display: grid;
    place-items: center;
    padding: 2px;
    border: 0;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: all .2s ease;
  }
  button:hover { color: var(--nav-active); rotate: 90deg; }
  .body { padding: 12px 16px; }
  blockquote { margin: 0 0 8px; font-size: .82rem; line-height: 1.75; font-style: italic; color: var(--text-primary); }
  figcaption { text-align: right; font-size: .73rem; color: var(--text-muted); }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".quote[data-quotes]").forEach(el => {
    const quotes: {quote: string; writer?: string; source?: string}[] = JSON.parse(el.dataset.quotes!);
    const q = el.querySelector("[data-q]")!;
    const c = el.querySelector("[data-c]")!;
    let last = -1;
    const show = () => {
      let i = Math.floor(Math.random() * quotes.length);
      if (quotes.length > 1 && i === last) i = (i + 1) % quotes.length;
      last = i;
      const {quote, writer, source} = quotes[i];
      q.textContent = `"${quote}"`;
      c.textContent = `${writer ? `— ${writer}` : ""}${source ? ` · ${source}` : ""}`;
    };
    show();
    el.querySelector("button")?.addEventListener("click", show);
  });
</script>
