---
import Icon from "./Icon.astro";
import {nav, profile} from "../data/site";

const path = Astro.url.pathname.replace(/\.html$/, "");
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---
<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label={`${profile.handle} home`}>
      <span class="mark" aria-hidden="true">S</span>
      <span class="brand-name">{profile.handle}</span>
    </a>

    <nav class="links" aria-label="Main">
      {nav.map(({label, href}) => (
        <a href={href} class:list={["link", {active: isActive(href)}]} aria-current={isActive(href) ? "page" : undefined}>
          {label}
        </a>
      ))}
    </nav>

    <div class="actions">
      <button class="search-btn" type="button" data-search-open aria-label="Search">
        <Icon name="search" size={16} />
        <span class="search-label">Search</span>
        <kbd>⌘K</kbd>
      </button>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle dark mode">
        <Icon name="moon" size={17} class="i-moon" />
        <Icon name="sun" size={17} class="i-sun" />
      </button>
      <button class="icon-btn menu-btn" type="button" data-menu-open aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>

  <div class="sheet" id="mobile-menu" hidden>
    <nav class="sheet-panel glass" aria-label="Mobile">
      {nav.map(({label, href}) => (
        <a href={href} class:list={["sheet-link", {active: isActive(href)}]}>
          {label}
          <Icon name="arrow" size={16} />
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 68%, transparent);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
  }
  .nav-inner { height: 100%; display: flex; align-items: center; gap: 24px; }

  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: -.02em; }
  .mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    color: #fff;
    font-size: .95rem;
    background: var(--grad);
    box-shadow: 0 4px 14px rgba(124, 58, 237, .35), inset 0 1px 0 rgba(255, 255, 255, .35);
  }
  .brand-name { font-size: 1.05rem; }

  .links { display: flex; gap: 2px; margin-left: 8px; }
  .link {
    position: relative;
    padding: 8px 12px;
    border-radius: 9px;
    font-size: .9rem;
    font-weight: 500;
    color: var(--text-2);
    transition: color .2s, background .2s;
  }
  .link:hover { color: var(--text); background: var(--accent-soft); }
  .link.active { color: var(--accent); font-weight: 600; }
  .link.active::after {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: -13px;
    height: 2px;
    border-radius: 2px;
    background: var(--grad);
  }

  .actions { margin-left: auto; display: flex; align-items: center; gap: 8px; }

  .search-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 10px 0 12px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-3);
    font-size: .85rem;
    cursor: pointer;
    transition: all .2s var(--ease);
  }
  .search-btn:hover { border-color: var(--border-strong); color: var(--text-2); }
  .search-label { min-width: 64px; text-align: left; }
  kbd {
    font: 500 .7rem var(--font-sans);
    padding: 2px 6px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  :global([data-theme="dark"] .i-moon), :global([data-theme="light"] .i-sun) { display: none; }

  .menu-btn { display: none; }

  .sheet {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    padding: 12px 16px;
    background: color-mix(in srgb, var(--bg) 40%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .sheet-panel { display: flex; flex-direction: column; padding: 8px; background: var(--surface-strong); animation: rise .25s var(--ease); }
  .sheet-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 14px;
    border-radius: 10px;
    font-weight: 550;
    color: var(--text-2);
  }
  .sheet-link:hover, .sheet-link.active { background: var(--accent-soft); color: var(--accent); }

  @media (max-width: 900px) {
    .links { display: none; }
    .menu-btn { display: inline-grid; }
    .search-label, kbd { display: none; }
    .search-btn { width: 38px; padding: 0; justify-content: center; }
  }
</style>

<script>
  const root = document.documentElement;

  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("theme-mode", next); } catch {}
  });

  const menuBtn = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const sheet = document.getElementById("mobile-menu");
  const setMenu = (open: boolean) => {
    if (!sheet || !menuBtn) return;
    sheet.hidden = !open;
    menuBtn.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  };
  menuBtn?.addEventListener("click", () => setMenu(!!sheet?.hidden));
  sheet?.addEventListener("click", e => { if (e.target === sheet) setMenu(false); });
  document.addEventListener("keydown", e => { if (e.key === "Escape") setMenu(false); });
  matchMedia("(min-width: 901px)").addEventListener("change", () => setMenu(false));
</script>
