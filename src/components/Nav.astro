---
import Icon from "./Icon.astro";
import ThemeMenu from "./ThemeMenu.astro";
import {nav, profile} from "../data/site";

const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "") || "/";
const isActive = (href: string) => href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---
<header class="appbar">
  <div class="toolbar">
    <a href="/" class="brand brand-text">{profile.handle}</a>

    <div class="desktop">
      <nav aria-label="Main">
        {nav.map(({label, href}) => (
          <a href={href} class:list={["nav-btn", {active: isActive(href)}]} aria-current={isActive(href) ? "page" : undefined}>{label}</a>
        ))}
      </nav>
      <button class="icon-btn" type="button" data-search-open aria-label="Search (Ctrl K)" title="Search (Ctrl K)"><Icon name="search" size={16} /></button>
      <ThemeMenu />
    </div>

    <div class="mobile">
      <button class="icon-btn" type="button" data-search-open aria-label="Search"><Icon name="search" size={16} /></button>
      <ThemeMenu />
      <button class="icon-btn" type="button" data-menu-open aria-label="Open menu" aria-expanded="false" aria-controls="nav-drawer"><Icon name="menu" size={18} /></button>
    </div>
  </div>
</header>

<div class="drawer-scrim" id="nav-drawer" hidden>
  <nav class="drawer" aria-label="Mobile">
    <div class="drawer-brand brand-text">{profile.handle}</div>
    <hr />
    {nav.map(({label, href}) => (
      <a href={href} class:list={["drawer-link", {active: isActive(href)}]}>{label}</a>
    ))}
  </nav>
</div>

<style>
  .appbar {
    position: sticky;
    top: 0;
    z-index: 1100;
    background: var(--nav-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--nav-border);
    box-shadow: var(--nav-shadow);
  }
  .toolbar {
    /* Same centred width as the page shell below. */
    max-width: 1240px;
    margin: 0 auto;
    min-height: 64px;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -.03em;
    user-select: none;
    transition: opacity .2s ease;
  }
  .brand:hover { opacity: .8; }

  .desktop { display: flex; align-items: center; gap: 2px; }
  .desktop nav { display: flex; gap: 2px; margin-right: 6px; }
  .desktop .icon-btn, .desktop :global(.theme-menu) { margin-left: 4px; }
  .nav-btn {
    position: relative;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: .85rem;
    font-weight: 400;
    letter-spacing: .01em;
    color: var(--text-muted);
    transition: all .18s ease;
  }
  .nav-btn::after {
    content: "";
    position: absolute;
    bottom: 3px;
    left: 50%;
    width: 55%;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #8B5CF6, #A78BFA);
    transform: translateX(-50%) scaleX(0);
    transition: transform .2s ease;
  }
  .nav-btn:hover { color: var(--text-primary); background: var(--nav-hover-bg); }
  .nav-btn:hover::after, .nav-btn.active::after { transform: translateX(-50%) scaleX(1); }
  .nav-btn.active { color: var(--nav-active); font-weight: 600; }


  .mobile { display: none; align-items: center; gap: 6px; }

  .drawer-scrim { position: fixed; inset: 0; z-index: 1200; background: rgba(15, 8, 40, .35); }
  .drawer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 220px;
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    background: var(--drawer-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-left: 1px solid var(--drawer-border);
    animation: sheetIn .22s ease;
  }
  .drawer-brand { padding: 0 20px 8px; font-weight: 700; font-size: 1.05rem; letter-spacing: -.02em; }
  .drawer hr { width: 100%; margin: 0 0 8px; border: 0; border-top: 1px solid var(--nav-border); }
  .drawer-link {
    padding: 8px 20px;
    font-size: .9rem;
    color: var(--text-secondary);
    border-left: 2px solid transparent;
  }
  .drawer-link:hover { background: var(--nav-hover-bg); color: var(--nav-active); }
  .drawer-link.active { background: var(--chip-bg); color: var(--nav-active); font-weight: 600; border-left-color: var(--nav-active); }

  @media (max-width: 899px) {
    .toolbar { padding: 0 16px; }
    .desktop { display: none; }
    .mobile { display: flex; }
  }
</style>

<script>


  const menuBtn = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const scrim = document.getElementById("nav-drawer");
  const setMenu = (open: boolean) => {
    if (!scrim || !menuBtn) return;
    scrim.hidden = !open;
    menuBtn.setAttribute("aria-expanded", String(open));
  };
  menuBtn?.addEventListener("click", () => setMenu(true));
  scrim?.addEventListener("click", e => { if (e.target === scrim) setMenu(false); });
  document.addEventListener("keydown", e => { if (e.key === "Escape") setMenu(false); });
</script>
