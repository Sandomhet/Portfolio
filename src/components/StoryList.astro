---
// Editorial list used by Writing and Blog.
import Icon from "./Icon.astro";
import {formatDate, readingMinutes, type Item} from "../lib/content";
interface Props { items: Item[] }
const {items} = Astro.props;
---
<div class="stories">
  {items.map((item, i) => (
    <a href={item.href} class:list={["story glass card-link", {lead: i === 0}]}>
      <div class="num" aria-hidden="true">{String(items.length - i).padStart(2, "0")}</div>
      <div class="body">
        <div class="meta">
          <time datetime={item.entry.data.time.toISOString()}>{formatDate(item.entry.data.time)}</time>
          <span>·</span>
          <span>{readingMinutes(item.entry.body)} min read</span>
        </div>
        <h2>{item.entry.data.title}</h2>
        {item.entry.data.description && <p>{item.entry.data.description}</p>}
        <span class="read">Read <Icon name="arrow" size={15} /></span>
      </div>
    </a>
  ))}
</div>

<style>
  .stories { display: flex; flex-direction: column; gap: 16px; }
  .story { display: grid; grid-template-columns: 72px 1fr; gap: 8px; padding: 26px 28px; border-radius: var(--radius-lg); }
  .num { font: 300 2.4rem/1 var(--font-sans); letter-spacing: -.04em; color: var(--accent-2); opacity: .55; }
  .meta { display: flex; gap: 8px; font-size: .8rem; color: var(--text-3); }
  h2 { margin: 6px 0 8px; font-size: 1.4rem; line-height: 1.25; letter-spacing: -.025em; font-weight: 720; }
  .lead h2 { font-size: 1.75rem; }
  p { margin: 0; color: var(--text-2); font-size: 1rem; font-style: italic; max-width: 640px; }
  .read { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; font-size: .85rem; font-weight: 600; color: var(--accent); }
  .read :global(svg) { transition: transform .25s var(--ease); }
  .story:hover .read :global(svg) { transform: translateX(4px); }
  @media (max-width: 560px) {
    .story { grid-template-columns: 1fr; padding: 22px; }
    .num { font-size: 1.6rem; }
  }
</style>
